+@router.get("/analytics/compare")
+async def analytics_compare(
+    days: int = Query(default=30, ge=1, le=180),
+    session: AsyncSession = Depends(get_session),
+) -> dict:
+    """Сравнение этого периода с предыдущим: дельты по метрикам."""
+    from datetime import datetime, timedelta
+
+    memory = MemoryStore(session)
+    now = datetime.utcnow()
+    cur_since = now - timedelta(days=days)
+    prev_since = now - timedelta(days=days * 2)
+    prev_until = cur_since
+
+    cur = await memory.engagement_stats(since=cur_since)
+    prev = await memory.engagement_stats(since=prev_since, until=prev_until)
+
+    def _delta(cur_val: float, prev_val: float) -> float:
+        if prev_val == 0:
+            return 0.0
+        return (cur_val - prev_val) / prev_val * 100.0
+
+    return {
+        "current": cur,
+        "previous": prev,
+        "deltas": {
+            "posts_count": _delta(float(cur["posts_count"]), float(prev["posts_count"])),
+            "avg_engagement": _delta(cur["avg_engagement"], prev["avg_engagement"]),
+            "total_likes": _delta(float(cur["total_likes"]), float(prev["total_likes"])),
+            "total_comments": _delta(float(cur["total_comments"]), float(prev["total_comments"])),
+            "total_views": _delta(float(cur["total_views"]), float(prev["total_views"])),
+        },
+        "days": days,
+    }
+
