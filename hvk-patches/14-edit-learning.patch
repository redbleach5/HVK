 ) -> EditorResult:
-    """Редактирует черновик без смены смысла и без «украшательства» ценой искренности."""
+    """Редактирует черновик без смены смысла и без «украшательства» ценой искренности.
+
+    Учится на отвергнутых правках: последние N «не зашло» по стилю
+    подмешиваются в промпт как «чего автору не подходит».
+    Так редактор не повторяет rejected-стиль через 2 недели.
+    """
     memory = MemoryStore(session)
     if await memory.count_posts() == 0:
         raise EmptyArchiveError("no posts")
@@ -55,6 +60,26 @@ async def edit_draft(
     if not voice_profile:
         archive_note += "\nпрофиля голоса ещё нет — правь бережно, без чужого тона"
 
+    # Уроки по стилю: что автор отвергал в прошлых правках
+    style_lessons = await memory.recent_style_lessons(limit=6)
+    style_block = ""
+    if style_lessons:
+        lines = []
+        for lesson in style_lessons:
+            # Lesson.title = "Не зашло: <title правки>", why = причина
+            title = (lesson.title or "").replace("Не зашло:", "").strip()
+            why_text = (lesson.why or "").strip()
+            if title:
+                line = f"— {title}"
+                if why_text and why_text != title:
+                    line += f" ({why_text[:120]})"
+                lines.append(line)
+        if lines:
+            style_block = (
+                "\n\nЧего автору НЕ подходит в правках (учитывай, не повторяй):\n"
+                + "\n".join(lines[:6])
+            )
+
     system = (
         f"{SYSTEM_ASSISTANT}\n"
         "Ты редактор текста. Сохраняй голос автора. Не меняй смысл, "
@@ -68,7 +93,7 @@ async def edit_draft(
 {voice_profile or "ещё не собран"}
 
 Её тексты (ритм и лексика, не копируй оптом):
-{archive_note}
+{archive_note}{style_block}
 
 Тема (если есть): {topic_hint or "не указана"}
 
