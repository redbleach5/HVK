+        if not active:
+            return False, None
+
+        # 1. Точное совпадение — быстро, без сети
+        topic_low = topic.lower()
+        for a in active:
+            if a.topic.lower() == topic_low:
+                return True, a.topic
+
+        # 2. Семантическое сравнение через эмбеддинги ChromaDB
+        try:
