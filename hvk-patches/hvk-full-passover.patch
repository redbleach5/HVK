+def _build_engagement_fig(series: list[dict], metric: str, title: str) -> "go.Figure":
+    """Plotly-график с тёплой палитрой — под светлый и тёмный режим."""
+    color = "#8B7355"
+    fig = px.line(
+        series,
+        x="date",
+        y=metric,
+        markers=True,
+        title=title,
+    )
+    fig.update_traces(
+        line_color=color,
+        marker_color=color,
+        marker_size=7,
+        line_width=2,
+    )
+    fig.update_layout(
+        paper_bgcolor="rgba(0,0,0,0)",
+        plot_bgcolor="rgba(0,0,0,0)",
+        font_family="Source Sans 3, sans-serif",
+        font_color="#3d3229",
+        margin=dict(l=8, r=8, t=42, b=8),
+        height=320,
+        title_font=dict(size=16, color="#3d3229"),
+        xaxis=dict(
+            gridcolor="rgba(139,115,85,0.12)",
+            zerolinecolor="rgba(139,115,85,0.18)",
+            tickformat="%d.%m",
+        ),
+        yaxis=dict(
+            gridcolor="rgba(139,115,85,0.12)",
+            zerolinecolor="rgba(139,115,85,0.18)",
+        ),
+        hoverlabel=dict(
+            bgcolor="#fffaf4",
+            font_color="#3d3229",
+            bordercolor="#e6dcd0",
+        ),
+    )
+    return fig
+
+
+def _build_heatmap_fig(rows: list[dict]) -> "go.Figure":
+    """Тепловая карта вовлечённости по дням недели × часам."""
+    if not rows:
+        fig = go.Figure()
+        fig.add_annotation(
+            text="Недостаточно данных для тепловой карты",
+            xref="paper", yref="paper",
+            x=0.5, y=0.5, showarrow=False,
+            font=dict(size=14, color="#7a6a5c"),
+        )
+        fig.update_layout(
+            paper_bgcolor="rgba(0,0,0,0)",
+            plot_bgcolor="rgba(0,0,0,0)",
+            height=300,
+            xaxis=dict(visible=False),
+            yaxis=dict(visible=False),
+            margin=dict(l=8, r=8, t=8, b=8),
+        )
+        return fig
+
+    weekdays_ru = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]
+    # 7 строк (дни) × 24 столбца (часы)
+    z = [[0.0] * 24 for _ in range(7)]
+    for r in rows:
+        wd = int(r.get("weekday", 0))
+        h = int(r.get("hour", 0))
+        if 0 <= wd < 7 and 0 <= h < 24:
+            z[wd][h] = float(r.get("avg_engagement", 0))
+
+    fig = go.Figure(data=go.Heatmap(
+        z=z,
+        x=[f"{h:02d}" for h in range(24)],
+        y=weekdays_ru,
+        colorscale=[[0, "#f4eee7"], [0.5, "#c9a986"], [1, "#8B7355"]],
+        hovertemplate="день: %{y}<br>час: %{x}:00<br>вовлечённость: %{z:.1f}<extra></extra>",
+        colorbar=dict(title="вовлечённость", thickness=12, len=0.8),
+    ))
+    fig.update_layout(
+        paper_bgcolor="rgba(0,0,0,0)",
+        plot_bgcolor="rgba(0,0,0,0)",
+        font_family="Source Sans 3, sans-serif",
+        font_color="#3d3229",
+        margin=dict(l=8, r=8, t=8, b=8),
+        height=280,
+        xaxis=dict(title="час публикации", tick0=0, dtick=2),
+        yaxis=dict(autorange="reversed"),
+    )
+    return fig
+
+
+def _render_delta_block(label: str, cur_val: float, prev_val: float, *, fmt: str = "{:.0f}") -> None:
+    """Карточка «текущее vs прошлое» с дельтой в %."""
+    if prev_val == 0:
+        delta_pct = 0.0
+        cls = "tr-delta-flat"
+        arrow = ""
+    else:
+        delta_pct = (cur_val - prev_val) / prev_val * 100.0
+        if abs(delta_pct) < 1.0:
+            cls = "tr-delta-flat"
+            arrow = "→"
+        elif delta_pct > 0:
+            cls = "tr-delta-up"
+            arrow = "↑"
+        else:
+            cls = "tr-delta-down"
+            arrow = "↓"
+    st.markdown(
+        f'<div class="tr-delta">'
+        f'<p class="tr-delta-label">{label}</p>'
+        f'<p class="tr-delta-value">{fmt.format(cur_val)} '
+        f'<span class="tr-delta-pct {cls}">{arrow} {abs(delta_pct):.0f}%</span></p>'
+        f'</div>',
+        unsafe_allow_html=True,
+    )
+
