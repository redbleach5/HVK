# --- приложение ---
APP_HOST=127.0.0.1
APP_PORT=8080
APP_TITLE=Тихая редакция

# --- Ollama: мозг на этом ПК ---
BRAIN_BASE_URL=http://127.0.0.1:11434/v1
BRAIN_MODEL=qwen3.8:27b

# --- Ollama: глаза ---
# Пока 7700 XT выключен — тот же qwen3.8:27b (vision). Не ставить gemma4:12b рядом с мозгом.
# С 7700 XT: EYES_BASE_URL=http://<7700xt>:11434/v1  EYES_MODEL=gemma4:12b
EYES_BASE_URL=http://127.0.0.1:11434/v1
EYES_MODEL=qwen3.8:27b

# --- VK (токен не показывается в интерфейсе) ---
VK_TOKEN=
VK_OWNER_ID=
# Пользовательский ключ админа сообщества (стена). Ключ группы не читает wall.get.
VK_WALL_TOKEN=

# --- Telegram-бот (необязательно) ---
TELEGRAM_BOT_TOKEN=

# --- пути данных ---
DATABASE_PATH=data/app.db
CHROMA_PATH=data/chroma
UPLOADS_PATH=data/uploads

# --- таймауты LLM, секунды (длинный ход мысли — норма, не ошибка) ---
LLM_TIMEOUT=900
VISION_TIMEOUT=900
