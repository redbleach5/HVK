# --- приложение ---
APP_HOST=127.0.0.1
APP_PORT=8080
APP_TITLE=Тихая редакция

# --- llama.cpp: текстовая модель (мозг) ---
BRAIN_BASE_URL=http://127.0.0.1:8000/v1
BRAIN_MODEL=qwen-27b
BRAIN_GGUF_PATH=C:\models\qwen3.8-27b-q4_k_m.gguf
LLAMA_SERVER_PATH=C:\llama.cpp\llama-server.exe

# --- llama.cpp: vision-модель (глаза) ---
EYES_BASE_URL=http://127.0.0.1:8001/v1
EYES_MODEL=gemma-12b
EYES_GGUF_PATH=C:\models\gemma4-12b-q5_k_m.gguf
EYES_MMPROJ_PATH=C:\models\gemma4-12b-mmproj.gguf

# --- VK (токен не показывается в интерфейсе) ---
VK_TOKEN=
VK_OWNER_ID=

# --- Telegram-бот (необязательно) ---
TELEGRAM_BOT_TOKEN=

# --- пути данных ---
DATABASE_PATH=data/app.db
CHROMA_PATH=data/chroma
UPLOADS_PATH=data/uploads

# --- таймауты LLM, секунды ---
LLM_TIMEOUT=180
VISION_TIMEOUT=240
